+def copy_generators_with_ids(poly: Polyhedron) -> tuple[Matrix, Sequence[int]]:
+    """Like :func:`~cdd.copy_generators`, but also returns a persistent
+    integer id for each generator (vertex/ray), aligned with the rows
+    of the returned matrix.
+
+    A generator that survives a :func:`~cdd.polyhedron_append_halfspaces`
+    call keeps the exact same id afterwards, so callers can recognize
+    "the same vertex" by an exact integer match instead of comparing
+    floating-point coordinates: an id present in an earlier snapshot but
+    absent from a later one identifies an eliminated generator, and an id
+    absent from an earlier snapshot but present in a later one identifies
+    a newly created one.
+
+    Only supported for an inequality (H-representation) *poly* whose
+    original matrix has full column rank, i.e. exactly what
+    :func:`~cdd.polyhedron_append_halfspaces` supports; a :exc:`ValueError`
+    is raised otherwise (e.g. for a V-representation *poly*, or one whose
+    original matrix left some direction entirely unconstrained).
+
+    .. versionadded:: 3.0.3
+    """
+    cdef dd_rowindex ids = NULL
+    cdef dd_ErrorType error = dd_NoError
+    cdef dd_MatrixPtr dd_mat = dd_CopyGeneratorsWithIds(
+        poly.dd_poly, &ids, &error
+    )
+    if dd_mat == NULL:
+        _raise_error(error)
+    try:
+        id_list = [ids[i] for i in range(dd_mat.rowsize)]
+    finally:
+        libc.stdlib.free(ids)
+    return matrix_from_ptr(dd_mat), id_list
+
+
+def polyhedron_append_halfspaces(poly: Polyhedron, mat: Matrix) -> None:
+    """Incrementally append the inequality rows of *mat* to *poly* in place,
+    resuming the double description method instead of recomputing the
+    polyhedron from scratch.
+
+    *poly* must already be a fully computed inequality (H-representation)
+    polyhedron (see :func:`~cdd.polyhedron_from_matrix`) whose original
+    matrix has full column rank, i.e. no direction is left entirely
+    unconstrained -- otherwise a :exc:`RuntimeError` is raised, since
+    cddlib permanently restructures its internal representation for such a
+    polyhedron in a way that is incompatible with resuming the computation
+    later. *mat* must contain only inequality rows (an empty
+    :attr:`~cdd.Matrix.lin_set`), and, if *poly* is homogeneous, every row
+    of *mat* must be homogeneous too.
+
+    After this call, *poly* itself reflects the updated polyhedron: use
+    :func:`~cdd.copy_generators` or :func:`~cdd.copy_generators_with_ids`
+    to retrieve its (updated) generators.
+
+    .. versionadded:: 3.0.3
+    """
+    cdef dd_ErrorType error = dd_NoError
+    if not dd_DDAppendHalfspaces(&poly.dd_poly, mat.dd_mat, &error):
+        _raise_error(error)
+
+
