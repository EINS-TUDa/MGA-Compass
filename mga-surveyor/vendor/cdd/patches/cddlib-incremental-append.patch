+dd_MatrixPtr dd_CopyGeneratorsWithIds(dd_PolyhedraPtr poly, dd_rowindex *ids,
+    dd_ErrorType *err)
+/* Like dd_CopyOutput/dd_CopyGenerators, but for exactly the case
+   dd_DDAppendHalfspaces supports (an inequality/H-representation
+   polyhedron with poly->child->LinearityDim==0, so every output row
+   corresponds to a real, live dd_RayType and none to a synthetic
+   dependent-column or origin row).  Returns the same generator matrix
+   dd_CopyGenerators would, and additionally allocates *ids as a parallel
+   array (one entry per output row, 0-indexed to match M->matrix) holding
+   that row's persistent ray id -- dd_RayType.id, assigned once when the
+   ray is created and never reused or changed for as long as the ray
+   survives (see dd_AddRay).  A ray that is untouched by a
+   dd_DDAppendHalfspaces call keeps the same id across the call, so a
+   caller can recognize "the same vertex" by an exact integer match
+   instead of a floating-point-tolerant value comparison; a row whose id
+   was not present in an earlier snapshot is a newly created generator,
+   and an id from an earlier snapshot missing from a later one was
+   eliminated.  Caller must free(*ids).  Returns NULL (and leaves *ids
+   untouched, *err set) if poly is not an inequality representation
+   (dd_NotAvailForV), has no fully-computed child (dd_PolyhedraNotComputed),
+   or has LinearityDim!=0 (dd_CannotHandleLinearity, the same restriction
+   and error code dd_DDAppendHalfspaces uses for this condition). */
+{
+  dd_RayPtr RayPtr;
+  dd_MatrixPtr M=NULL;
+  dd_rowrange i=0,total;
+
+  *ids=NULL;
+  *err=dd_NoError;
+  if (poly==NULL || poly->representation!=dd_Inequality) {
+    *err=dd_NotAvailForV;
+    return NULL;
+  }
+  if (poly->child==NULL || poly->child->CompStatus!=dd_AllFound) {
+    *err=dd_PolyhedraNotComputed;
+    return NULL;
+  }
+  if (poly->child->LinearityDim!=0) {
+    *err=dd_CannotHandleLinearity;
+    return NULL;
+  }
+
+  total=poly->child->FeasibleRayCount;
+  M=dd_CreateMatrix(total, poly->d);
+  *ids=(dd_rowindex) calloc(total>0 ? total : 1, sizeof(long));
+
+  for (RayPtr=poly->child->FirstRay; RayPtr!=NULL; RayPtr=RayPtr->Next) {
+    if (RayPtr->feasible) {
+      dd_CopyRay(M->matrix[i], poly->d, RayPtr, dd_Generator, poly->child->newcol);
+      (*ids)[i]=RayPtr->id;
+      i++;
+    }
+  }
+  dd_MatrixIntegerFilter(M);
+  M->representation=dd_Generator;
+  return M;
+}
+
 dd_MatrixPtr dd_CopyInequalities(dd_PolyhedraPtr poly)
 {
   dd_MatrixPtr M=NULL;
diff --git a/lib-src/cddlib.c b/lib-src/cddlib.c
index 56db80a..ffc716a 100644
--- a/lib-src/cddlib.c
+++ b/lib-src/cddlib.c
@@ -329,6 +329,161 @@ dd_boolean dd_DDInputAppend(dd_PolyhedraPtr *poly, dd_MatrixPtr M,
   return found;
 }
 
+dd_boolean dd_DDAppendHalfspaces(dd_PolyhedraPtr *poly, dd_MatrixPtr Mnew,
+  dd_ErrorType *err)
+{
+  /* True incremental append: unlike dd_DDInputAppend/dd_AppendMatrix2Poly
+     above, this keeps the existing cone alive and resumes dd_DDMain over
+     only the newly appended rows, instead of recomputing everything.
+     See cdd.h for the restrictions this relies on (no equality rows in
+     Mnew; homogeneity of *poly must be preserved by every appended row;
+     *poly must already be fully computed). */
+  dd_PolyhedraPtr p;
+  dd_ConePtr cone;
+  dd_rowrange old_cone_m,new_cone_m,new_row_first,new_row_last,i;
+  dd_boolean has_hom_row;
+
+  *err=dd_NoError;
+  p=*poly;
+
+  if (p==NULL || p->representation!=dd_Inequality) {
+    *err=dd_NotAvailForV;
+    return dd_FALSE;
+  }
+  if (p->child==NULL || p->child->CompStatus!=dd_AllFound) {
+    *err=dd_PolyhedraNotComputed;
+    return dd_FALSE;
+  }
+  if (Mnew==NULL || Mnew->rowsize==0) return dd_TRUE;  /* nothing to do */
+  if (Mnew->colsize!=p->d) {
+    *err=dd_ColIndexOutOfRange;
+    return dd_FALSE;
+  }
+  if (set_card(Mnew->linset)>0) {
+    *err=dd_CannotHandleLinearity;
+    return dd_FALSE;
+  }
+  if (p->child->LinearityDim>0) {
+    /* cone->d was permanently reduced by dd_ColumnReduce during the initial
+       build (cddcore.c: cone->LinearityDim = cone->d - rank(A), triggered
+       whenever the *initial* matrix leaves some direction unconstrained --
+       not only by explicit equality rows).  cone->A's columns no longer
+       correspond 1:1 to Mnew's columns, and re-deriving the reduced basis
+       to accommodate new rows is exactly the destructive
+       dd_FindInitialRays/dd_InitialDataSetup work this function must skip.
+       Reject rather than silently insert misaligned column data. */
+    *err=dd_CannotHandleLinearity;
+    return dd_FALSE;
+  }
+  if (p->homogeneous) {
+    for (i=1; i<=Mnew->rowsize; i++)
+      if (dd_Nonzero(Mnew->matrix[i-1][0])) {
+        *err=dd_PolyhedraNotComputed;
+        return dd_FALSE;
+      }
+  }
+
+  cone=p->child;
+  old_cone_m=cone->m;
+  has_hom_row=(p->representation==dd_Inequality && !p->homogeneous);
+
+  dd_PolyhedraAppendRows(p, Mnew);
+  new_cone_m=p->m+(has_hom_row ? 1 : 0);
+
+  dd_ConeGrowCapacity(cone, new_cone_m+2);
+  dd_SetInequalitySets(cone);  /* rebuild GroundSet/EqualitySet/NonequalitySet for the new poly->m */
+  dd_ConeGrowRayZeroSets(cone, new_cone_m);  /* must precede relabeling below */
+  dd_ConeInsertNewRowsIntoA(cone, Mnew, old_cone_m, new_cone_m, has_hom_row);
+  dd_ConeExtendOrderVector(cone, old_cone_m, new_cone_m, has_hom_row);
+  if (has_hom_row) dd_ConeRelabelHomogenizingRow(cone, old_cone_m, new_cone_m);
+    /* Must run BEFORE dd_ConeUpdateExistingRayZeroSets below: right after
+       dd_ConeInsertNewRowsIntoA, the newly-inserted row's number is the
+       SAME number the homogenizing row used to have (its old slot was
+       reused).  Relabeling moves the *old* meaning of that bit (tightness
+       against the homogenizing row) away to its new number first, so that
+       setting the bit again next -- for the unrelated fact that a ray may
+       also be tight against the genuinely new row now at that same number
+       -- can never be confused with or clobbered by the relabeling. */
+  if (has_hom_row) { new_row_first=old_cone_m; new_row_last=new_cone_m-1; }
+  else { new_row_first=old_cone_m+1; new_row_last=new_cone_m; }
+  dd_ConeUpdateExistingRayZeroSets(cone, new_row_first, new_row_last);
+  dd_ConePatchFirstInfeasIndex(cone, old_cone_m, new_cone_m);
+
+  cone->m=new_cone_m;
+  p->m1=new_cone_m;
+  cone->CompStatus=dd_InProgress;
+  cone->Iteration=old_cone_m+1;
+    /* dd_DDMain's own loop has an early-exit path (cddlib.c: once
+       RayCount==WeaklyFeasibleRayCount mid-loop, it jumps to its tail via
+       goto _L99 WITHOUT running the loop's own Iteration++) that can leave
+       cone->Iteration well short of old_cone_m+1 even though every row up
+       to old_cone_m was already correctly folded in and CompStatus is
+       dd_AllFound -- the precondition check above only verifies
+       CompStatus, not Iteration, so a resumed run can inherit that stale
+       value.  Left uncorrected, the while(Iteration<=m) loop below then
+       runs MORE iterations than there are actually-new rows to process:
+       after the genuinely new rows are exhausted, dd_SelectNextHalfspace
+       has nothing left to select (every row is already in
+       WeaklyAddedHalfspaces) and returns an invalid row number, which
+       dd_AddNewHalfspace1 then dereferences into cone->A -- an
+       out-of-bounds access. Resetting Iteration here to exactly
+       old_cone_m+1 makes the resumed loop run precisely
+       new_cone_m-old_cone_m times (one per newly appended row),
+       regardless of what the previous run's own Iteration bookkeeping
+       happened to end on. */
+  cone->PreOrderedRun=dd_FALSE;
+    /* Force dd_AddNewHalfspace1 for the resumed portion, regardless of the
+       HalfspaceOrder used for the initial build.  dd_AddNewHalfspace2 (the
+       PreOrderedRun==TRUE path, e.g. the dd_LexMin default) relies entirely
+       on adjacency pairs pre-scheduled into cone->Edges[] at ray-creation
+       time via dd_ConditionalAddEdge -- and that scheduler explicitly skips
+       any pair whose FirstInfeasIndex values are EQUAL (cddcore.c: "equal
+       FII value -> No edge added"), reasoning that two rays which are both
+       "feasible forever" never need to be combined.  That is true only if m
+       never grows: once new rows are appended, two such rays can still be
+       genuinely adjacent and require combining if one of them is later
+       eliminated -- but that pair was never scheduled, at any iteration, so
+       dd_AddNewHalfspace2 silently drops the new vertex/ray that should
+       replace the eliminated one.  dd_AddNewHalfspace1 has no such
+       precomputed schedule: it re-derives adjacency by a fresh pairwise
+       scan of the live ray list on every call, so it always finds this
+       combination correctly.  Row selection order is a performance
+       heuristic only (dd_SelectNextHalfspace falls back to
+       dd_SelectNextHalfspace0 for any HalfspaceOrder it doesn't special-case
+       when PreOrderedRun is off), so this never affects correctness. */
+
+  dd_DDMain(cone);  /* resumes from cone->Iteration=old_cone_m+1, set above */
+
+  if (cone->CompStatus==dd_InProgress && cone->Iteration>cone->m)
+    cone->CompStatus=dd_AllFound;
+    /* Safety net: WeaklyFeasibleRayCount only ever increases, so if this
+       append eliminated a ray that an earlier run had already counted as
+       weakly feasible, RayCount==WeaklyFeasibleRayCount may never become
+       true again even though the loop has legitimately finished. */
+
+  if (cone->CompStatus==dd_AllFound) {
+    /* dd_DDMain's own tail bookkeeping (cone->parent->n/ldim, the output
+       size) is derived from cone->FeasibleRayCount -- a count that, unlike
+       in a from-scratch run, is stale here: it only ever increases, so a
+       ray that was feasible against the smaller old m but got eliminated
+       by a newly appended row is still counted.  Once the run has
+       genuinely completed, every ray still in FirstRay is, by the DD
+       method's own invariant, feasible against all cone->m rows, so
+       cone->RayCount is the correct current count -- resync it and
+       recompute the output size exactly as dd_DDMain's tail does. */
+    cone->FeasibleRayCount=cone->RayCount;
+    if (cone->d<=0 || cone->newcol[1]==0){
+      cone->parent->n=cone->LinearityDim + cone->FeasibleRayCount -1;
+      cone->parent->ldim=cone->LinearityDim -1;
+    } else {
+      cone->parent->n=cone->LinearityDim + cone->FeasibleRayCount;
+      cone->parent->ldim=cone->LinearityDim;
+    }
+  }
+
+  return (cone->CompStatus==dd_AllFound);
+}
