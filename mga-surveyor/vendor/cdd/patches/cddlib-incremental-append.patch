   dd_bigrange LinearityDim;   
diff --git a/lib-src/setoper.c b/lib-src/setoper.c
index 1967598..98f622a 100644
--- a/lib-src/setoper.c
+++ b/lib-src/setoper.c
@@ -69,6 +69,27 @@ void set_free(set_type set)
     free(set);
 }
 
+void set_realloc(set_type *setp, long newlength)
+/* Grow or shrink the set *setp in place to a new ground set size,
+   preserving elements that still fit and zero-filling the rest.
+   Note: set_copy() must NOT be used for growing a set -- it loops over
+   set_blocks(setcopy[0])-1 blocks reading from the source, so if the
+   destination is larger than the source it reads past the source's
+   allocation. */
+{
+	set_type newset;
+	long oldblocks,newblocks,copyblocks,i;
+
+	oldblocks=set_blocks((*setp)[0])-1;
+	set_initialize(&newset, newlength);
+	newblocks=set_blocks(newset[0])-1;
+	copyblocks=(oldblocks<newblocks) ? oldblocks : newblocks;
+	for (i=1; i<=copyblocks; i++)
+		newset[i]=(*setp)[i];
+	set_free(*setp);
+	*setp=newset;
+}
