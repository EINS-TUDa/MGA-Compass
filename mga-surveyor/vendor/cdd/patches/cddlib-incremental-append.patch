+/* --- Incremental halfspace append support (dd_DDAppendHalfspaces) ---
+   The following six helpers grow and relabel a live cone's row-indexed
+   state so that dd_DDMain can be resumed after new inequalities are
+   appended, instead of rebuilding the cone from scratch.  See
+   dd_DDAppendHalfspaces in cddlib.c for the orchestration and rationale. */
+
+void dd_ConeGrowCapacity(dd_ConePtr cone, dd_rowrange new_alloc)
+/* Grow the m_alloc-sized arrays of cone (bitsets, Edges, OrderVector, A) to
+   hold at least new_alloc rows.  This only grows capacity; it does not
+   change cone->m or fill in any new row's content -- see
+   dd_ConeInsertNewRowsIntoA for that.  A no-op if already large enough. */
+{
+  dd_rowrange old_alloc,i;
+
+  old_alloc=cone->m_alloc;
+  if (new_alloc<=old_alloc) return;
+
+  set_realloc(&(cone->GroundSet), new_alloc);
+  set_realloc(&(cone->EqualitySet), new_alloc);
+  set_realloc(&(cone->NonequalitySet), new_alloc);
+  set_realloc(&(cone->AddedHalfspaces), new_alloc);
+  set_realloc(&(cone->WeaklyAddedHalfspaces), new_alloc);
+  set_realloc(&(cone->InitialHalfspaces), new_alloc);
+    /* InitialHalfspaces is only ever read during the one-time
+       dd_FindInitialRays/dd_InitialDataSetup sequence, never again on a
+       resumed run -- grown here only defensively, for size consistency. */
+
+  cone->Edges=(dd_AdjacencyType**) realloc(cone->Edges, new_alloc*sizeof(dd_AdjacencyType*));
+  for (i=old_alloc; i<new_alloc; i++) cone->Edges[i]=NULL;
+
+  cone->OrderVector=(long*) realloc(cone->OrderVector, (new_alloc+1)*sizeof(long));
+
+  cone->A=(dd_Amatrix) realloc(cone->A, new_alloc*sizeof(mytype*));
+  for (i=old_alloc; i<new_alloc; i++) dd_InitializeArow(cone->d, &(cone->A[i]));
+
+  cone->m_alloc=new_alloc;
+}
+
+void dd_ConeGrowRayZeroSets(dd_ConePtr cone, dd_rowrange new_cone_m)
+/* Grow every live ray's ZeroSet (and the artificial ray's) to size
+   new_cone_m, matching how a freshly-created ray's ZeroSet is sized
+   (set_initialize(&RR->ZeroSet, cone->m) in dd_StoreRay1/2).  Without this,
+   later set_member/set_int/set_subset calls against the now-larger
+   AddedHalfspaces/ZeroSet pairs (e.g. in dd_ConditionalAddEdge) would be
+   size-mismatched.  Must run before dd_ConeRelabelHomogenizingRow. */
+{
+  dd_RayPtr RayPtr;
+
+  if (cone->ArtificialRay!=NULL)
+    set_realloc(&(cone->ArtificialRay->ZeroSet), new_cone_m);
+  for (RayPtr=cone->FirstRay; RayPtr!=NULL; RayPtr=RayPtr->Next)
+    set_realloc(&(RayPtr->ZeroSet), new_cone_m);
+}
+
+void dd_ConeInsertNewRowsIntoA(dd_ConePtr cone, dd_MatrixPtr Mnew,
+    dd_rowrange old_cone_m, dd_rowrange new_cone_m, dd_boolean has_hom_row)
+/* Write the newly appended rows' coefficients into cone->A.  When an
+   inhomogeneous H-representation's artificial homogenizing row (1,0,...,0)
+   is present, it currently occupies row old_cone_m and must move to the
+   new last row new_cone_m, since the new inequalities take over its old
+   slot.  The move is done by rotating row-POINTERS (never copying row
+   values), so the homogenizing row's own storage is never aliased or
+   overwritten by the dd_set calls that follow. */
+{
+  dd_rowrange i,k=Mnew->rowsize,fill_start;
+  dd_colrange j,d=cone->d;
+  mytype *hom_row;
+
+  if (has_hom_row) {
+    hom_row=cone->A[old_cone_m-1];
+    for (i=old_cone_m-1; i<new_cone_m-1; i++)
+      cone->A[i]=cone->A[i+1];
+    cone->A[new_cone_m-1]=hom_row;
+    fill_start=old_cone_m-1;
+  } else {
+    fill_start=old_cone_m;
+  }
+
+  for (i=0; i<k; i++)
+    for (j=0; j<d; j++)
+      dd_set(cone->A[fill_start+i][j], Mnew->matrix[i][j]);
+}
+
+void dd_ConeUpdateExistingRayZeroSets(dd_ConePtr cone,
+    dd_rowrange new_row_first, dd_rowrange new_row_last)
+/* A ray's ZeroSet is populated once, at creation time (dd_StoreRay1/2), by
+   testing it against exactly the rows that existed at that moment -- it is
+   never retroactively re-tested against rows appended later, even when a
+   newly appended row happens to be exactly tight (zero) for that ray. In a
+   normal from-scratch run this is harmless, since cone->m is fixed and
+   known from the start, so every ray's ZeroSet already reflects the full
+   and final row set the instant it is created. On resume, though, a ray
+   surviving from before this append can be genuinely tight against one of
+   the newly-inserted rows without that ever being recorded.
+   dd_CheckAdjacency's combinatorial test intersects two rays' ZeroSets
+   with cone->AddedHalfspaces to measure their common face: an omitted bit
+   here silently undercounts that face and can wrongly declare a genuinely
+   adjacent pair non-adjacent, causing dd_AddNewHalfspace1 to skip a vertex/
+   ray it should have created. Evaluate every currently-live ray (and the
+   artificial ray) against each newly-inserted row and record any exact
+   zero, before dd_DDMain resumes. Must run after dd_ConeInsertNewRowsIntoA
+   (needs the new rows' data already in cone->A) and after
+   dd_ConeGrowRayZeroSets (needs capacity for the new row numbers).
+
+   Same pass also repairs cone->WeaklyFeasibleRayCount, for the same
+   underlying reason: dd_StoreRay1/2 sets a ray's `feasible` flag (and
+   increments this counter) by testing it against cone->m AT THE RAY'S OWN
+   CREATION TIME. A ray surviving from before this append had that test
+   done against the OLD, smaller m -- it has never actually been checked
+   against the newly-inserted rows, yet its `feasible` flag and this
+   counter's contribution from it are already fixed as if it had been.
+   dd_DDMain's own early-exit optimization (cddlib.c: "if
+   (cone->RayCount==cone->WeaklyFeasibleRayCount) cone->CompStatus=
+   dd_AllFound") trusts this counter to mean "every currently-live ray is
+   feasible against the full current row set, so nothing further can ever
+   go infeasible" -- true in a fresh build (m fixed throughout), false
+   here unless corrected: a stale-feasible survivor that actually violates
+   one of the not-yet-processed new rows can make RayCount equal this
+   counter by sheer coincidence (eliminations and new-ray creations
+   changing both sides in step) long before every new row has actually
+   been folded in via dd_AddNewHalfspace1/2, causing dd_DDMain to stop and
+   silently skip whichever new rows dd_SelectNextHalfspace0's
+   largest-index-first order had not yet reached (confirmed in practice:
+   a 3-row batch append left 2 of the 3 rows completely unprocessed this
+   way, producing 14 vertices where the true, independently-recomputed
+   answer was 12). A ray found negative here was, in truth, never
+   feasible against the current row set at all -- correct its `feasible`
+   flag and this counter immediately, rather than waiting for
+   dd_AddNewHalfspace1 to eventually reach the offending row and evaluate
+   it directly (which still happens, and still correctly eliminates it --
+   this fix only stops the early-exit heuristic from short-circuiting
+   before that happens). */
+{
+  dd_RayPtr RayPtr;
+  dd_rowrange k;
+  mytype temp;
+
+  dd_init(temp);
+  for (k=new_row_first; k<=new_row_last; k++) {
+    dd_AValue(&temp, cone->d, cone->A, cone->ArtificialRay->Ray, k);
+    if (dd_EqualToZero(temp)) set_addelem(cone->ArtificialRay->ZeroSet, k);
+    for (RayPtr=cone->FirstRay; RayPtr!=NULL; RayPtr=RayPtr->Next) {
+      dd_AValue(&temp, cone->d, cone->A, RayPtr->Ray, k);
+      if (dd_EqualToZero(temp)) set_addelem(RayPtr->ZeroSet, k);
+      else if (dd_Negative(temp) && RayPtr->feasible) {
+        RayPtr->feasible = dd_FALSE;
+        (cone->WeaklyFeasibleRayCount)--;
+      }
+    }
+  }
+  dd_clear(temp);
+}
+
+void dd_ConeExtendOrderVector(dd_ConePtr cone, dd_rowrange old_cone_m,
+    dd_rowrange new_cone_m, dd_boolean has_hom_row)
+/* Append entries for the newly appended rows to cone->OrderVector, without
+   touching positions [1..old_cone_m] except relocating the homogenizing
+   row's own entry when present (its row number changes from old_cone_m to
+   new_cone_m -- see dd_ConeInsertNewRowsIntoA).  Safe for both
+   PreOrderedRun settings: dd_SelectPreorderedNext just linearly scans
+   OrderVector[1..m] for an unprocessed row, and the non-preordered
+   dd_DDMain loop rewrites OrderVector dynamically as it goes regardless. */
+{
+  dd_rowrange p,idx;
+
+  if (has_hom_row) {
+    for (p=1; p<=old_cone_m; p++)
+      if (cone->OrderVector[p]==old_cone_m) { cone->OrderVector[p]=new_cone_m; break; }
+    for (idx=1; idx<=new_cone_m-old_cone_m; idx++)
+      cone->OrderVector[old_cone_m+idx]=old_cone_m+idx-1;
+  } else {
+    for (idx=1; idx<=new_cone_m-old_cone_m; idx++)
+      cone->OrderVector[old_cone_m+idx]=old_cone_m+idx;
+  }
+}
+
+void dd_ConeRelabelHomogenizingRow(dd_ConePtr cone, dd_rowrange old_cone_m,
+    dd_rowrange new_cone_m)
+/* The homogenizing row's cone-row-number changed from old_cone_m to
+   new_cone_m (see dd_ConeInsertNewRowsIntoA).  Move the corresponding bit
+   in every row-indexed set that may reference it: AddedHalfspaces,
+   WeaklyAddedHalfspaces, and every live (including artificial) ray's
+   ZeroSet.  Must run after dd_ConeGrowRayZeroSets, since set_addelem
+   silently no-ops on a set too small to hold new_cone_m. */
+{
+  dd_RayPtr RayPtr;
+
+  if (set_member(old_cone_m, cone->AddedHalfspaces)) {
+    set_delelem(cone->AddedHalfspaces, old_cone_m);
+    set_addelem(cone->AddedHalfspaces, new_cone_m);
+  }
+  if (set_member(old_cone_m, cone->WeaklyAddedHalfspaces)) {
+    set_delelem(cone->WeaklyAddedHalfspaces, old_cone_m);
+    set_addelem(cone->WeaklyAddedHalfspaces, new_cone_m);
+  }
+  if (cone->ArtificialRay!=NULL && set_member(old_cone_m, cone->ArtificialRay->ZeroSet)) {
+    set_delelem(cone->ArtificialRay->ZeroSet, old_cone_m);
+    set_addelem(cone->ArtificialRay->ZeroSet, new_cone_m);
+  }
+  for (RayPtr=cone->FirstRay; RayPtr!=NULL; RayPtr=RayPtr->Next) {
+    if (set_member(old_cone_m, RayPtr->ZeroSet)) {
+      set_delelem(RayPtr->ZeroSet, old_cone_m);
+      set_addelem(RayPtr->ZeroSet, new_cone_m);
+    }
+  }
+}
+
+void dd_ConePatchFirstInfeasIndex(dd_ConePtr cone, dd_rowrange old_cone_m,
+    dd_rowrange new_cone_m)
+/* Every ray alive when a run finishes carries FirstInfeasIndex==old_cone_m+1
+   as a sentinel meaning "feasible against every row tested so far" (see
+   dd_StoreRay1/dd_StoreRay2).  Once cone->m grows, that stale value would
+   silently become a real, wrong iteration position instead of "infinity",
+   which would corrupt dd_ConditionalAddEdge/dd_AddNewHalfspace2's edge
+   scheduling.  dd_DDAppendHalfspaces currently forces PreOrderedRun=FALSE
+   for every resumed call specifically because that scheduling has its own,
+   deeper incompatibility with resumption (see the comment in
+   dd_DDAppendHalfspaces), so dd_AddNewHalfspace1 -- which never reads
+   FirstInfeasIndex -- is what actually runs.  This patch is kept anyway as
+   a defensive measure, in case PreOrderedRun is ever re-enabled here. */
+{
+  dd_RayPtr RayPtr;
+
+  if (cone->ArtificialRay!=NULL && cone->ArtificialRay->FirstInfeasIndex==old_cone_m+1)
+    cone->ArtificialRay->FirstInfeasIndex=new_cone_m+1;
+  for (RayPtr=cone->FirstRay; RayPtr!=NULL; RayPtr=RayPtr->Next)
+    if (RayPtr->FirstInfeasIndex==old_cone_m+1)
+      RayPtr->FirstInfeasIndex=new_cone_m+1;
+}
+
 
