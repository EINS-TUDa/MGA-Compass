+void dd_PolyhedraAppendRows(dd_PolyhedraPtr poly, dd_MatrixPtr Mnew)
+/* Append the rows of Mnew to poly->A in place, growing poly->A and
+   poly->EqualityIndex only when the existing m+2 slack allocation
+   (dd_CreatePolyhedraData) is not enough.  Used by dd_DDAppendHalfspaces
+   (cddlib.c) for the incremental halfspace-append feature; unlike
+   dd_AppendMatrix2Poly/dd_MatrixAppendTo, this never rebuilds a fresh
+   matrix and copies everything -- since poly->A is an array of
+   independently-allocated row pointers, growing it is a cheap realloc of
+   the pointer array plus initializing only the new rows. */
+{
+  dd_rowrange old_m,new_m,old_alloc,new_alloc,i;
+  dd_colrange j,d=poly->d;
+
+  old_m=poly->m;
+  new_m=old_m+Mnew->rowsize;
+  old_alloc=poly->m_alloc;
+  new_alloc=new_m+2;
+
+  if (new_alloc>old_alloc) {
+    poly->A=(dd_Amatrix) realloc(poly->A, new_alloc*sizeof(mytype*));
+    for (i=old_alloc; i<new_alloc; i++) dd_InitializeArow(d, &(poly->A[i]));
+
+    poly->EqualityIndex=(dd_rowflag) realloc(poly->EqualityIndex, new_alloc*sizeof(int));
+    for (i=old_alloc; i<new_alloc; i++) poly->EqualityIndex[i]=0;
+
+    poly->m_alloc=new_alloc;
+  }
+
+  for (i=0; i<Mnew->rowsize; i++)
+    for (j=0; j<d; j++)
+      dd_set(poly->A[old_m+i][j], Mnew->matrix[i][j]);
+
+  poly->m=new_m;
+  poly->n=-1;  /* output size is stale until dd_DDMain recomputes it */
+}
